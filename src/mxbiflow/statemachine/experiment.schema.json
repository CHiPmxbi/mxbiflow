{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Experiment",
  "$defs": {
    "Experiment": {
      "type": "object",
      "properties": {
        "stages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stage"
          }
        }
      },
      "required": [
        "stages"
      ],
      "additionalProperties": false
    },
    "Stage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "$ref": "#/$defs/Machine"
        },
        "outcomes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "correct",
              "incorrect",
              "miss"
            ]
          }
        }
      },
      "required": [
        "name",
        "machine",
        "outcomes"
      ],
      "additionalProperties": false
    },
    "Machine": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "object",
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "inputs",
            "outputs"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "timers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Timer"
          }
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Counter"
          }
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/State"
          }
        },
        "layout": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/Place"
          }
        },
        "screen": {
          "$ref": "#/$defs/ScreenSize"
        },
        "stimuli": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stimulus"
          }
        }
      },
      "required": [
        "channels",
        "parameters",
        "timers",
        "counters",
        "start",
        "groups",
        "states",
        "layout",
        "screen",
        "stimuli"
      ],
      "additionalProperties": false
    },
    "Parameter": {
      "oneOf": [
        {
          "$ref": "#/$defs/TimeParameter"
        },
        {
          "$ref": "#/$defs/CountParameter"
        },
        {
          "$ref": "#/$defs/StateParameter"
        },
        {
          "$ref": "#/$defs/NumberParameter"
        },
        {
          "$ref": "#/$defs/StimulusParameter"
        }
      ]
    },
    "TimeParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "time"
        },
        "default": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false
    },
    "CountParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "count"
        },
        "default": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false
    },
    "StateParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "state"
        },
        "default": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false
    },
    "NumberParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "number"
        },
        "default": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false
    },
    "StimulusParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "stimulus"
        },
        "default": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false
    },
    "Timer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "$ref": "#/$defs/Amount"
        }
      },
      "required": [
        "name",
        "time"
      ],
      "additionalProperties": false
    },
    "Amount": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/ParamRef"
        }
      ]
    },
    "ParamRef": {
      "type": "object",
      "properties": {
        "param": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "param"
      ],
      "additionalProperties": false
    },
    "Counter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "$ref": "#/$defs/Amount"
        }
      },
      "required": [
        "name",
        "event",
        "limit"
      ],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "onEntry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "onExit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transition"
          }
        }
      },
      "required": [
        "name",
        "group",
        "onEntry",
        "onExit",
        "transitions"
      ],
      "additionalProperties": false
    },
    "Action": {
      "anyOf": [
        {
          "$ref": "#/$defs/HighAction"
        },
        {
          "$ref": "#/$defs/LowAction"
        },
        {
          "$ref": "#/$defs/CancelAction"
        },
        {
          "$ref": "#/$defs/StartAction"
        },
        {
          "$ref": "#/$defs/StopAction"
        },
        {
          "$ref": "#/$defs/ResetAction"
        },
        {
          "$ref": "#/$defs/ShowAction"
        },
        {
          "$ref": "#/$defs/HideAction"
        },
        {
          "$ref": "#/$defs/ClearAction"
        },
        {
          "$ref": "#/$defs/PlayAction"
        }
      ]
    },
    "HighAction": {
      "type": "object",
      "properties": {
        "high": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ]
        }
      },
      "required": [
        "high"
      ],
      "additionalProperties": false
    },
    "LowAction": {
      "type": "object",
      "properties": {
        "low": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ]
        }
      },
      "required": [
        "low"
      ],
      "additionalProperties": false
    },
    "CancelAction": {
      "type": "object",
      "properties": {
        "cancel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cancel"
      ],
      "additionalProperties": false
    },
    "StartAction": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start"
      ],
      "additionalProperties": false
    },
    "StopAction": {
      "type": "object",
      "properties": {
        "stop": {
          "$ref": "#/$defs/StimulusRef"
        }
      },
      "required": [
        "stop"
      ],
      "additionalProperties": false
    },
    "StimulusRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/ParamRef"
        }
      ]
    },
    "ResetAction": {
      "type": "object",
      "properties": {
        "reset": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reset"
      ],
      "additionalProperties": false
    },
    "ShowAction": {
      "type": "object",
      "properties": {
        "show": {
          "$ref": "#/$defs/StimulusRef"
        }
      },
      "required": [
        "show"
      ],
      "additionalProperties": false
    },
    "HideAction": {
      "type": "object",
      "properties": {
        "hide": {
          "$ref": "#/$defs/StimulusRef"
        }
      },
      "required": [
        "hide"
      ],
      "additionalProperties": false
    },
    "ClearAction": {
      "type": "object",
      "properties": {
        "clear": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "clear"
      ],
      "additionalProperties": false
    },
    "PlayAction": {
      "type": "object",
      "properties": {
        "play": {
          "$ref": "#/$defs/StimulusRef"
        }
      },
      "required": [
        "play"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        }
      },
      "required": [
        "event",
        "target",
        "actions"
      ],
      "additionalProperties": false
    },
    "Target": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/ParamRef"
        }
      ]
    },
    "State": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "onEntry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "onExit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transition"
          }
        }
      },
      "required": [
        "name",
        "group",
        "onEntry",
        "onExit",
        "transitions"
      ],
      "additionalProperties": false
    },
    "Place": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "ScreenSize": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "Stimulus": {
      "oneOf": [
        {
          "$ref": "#/$defs/ImageStimulus"
        },
        {
          "$ref": "#/$defs/CircleStimulus"
        },
        {
          "$ref": "#/$defs/RectStimulus"
        },
        {
          "$ref": "#/$defs/CrossStimulus"
        },
        {
          "$ref": "#/$defs/TextStimulus"
        },
        {
          "$ref": "#/$defs/BackgroundStimulus"
        },
        {
          "$ref": "#/$defs/WavStimulus"
        },
        {
          "$ref": "#/$defs/TonesStimulus"
        }
      ]
    },
    "ImageStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "image"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/Amount"
        },
        "y": {
          "$ref": "#/$defs/Amount"
        },
        "size": {
          "type": "string",
          "enum": [
            "px",
            "fraction"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "image": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^data:image\\/"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "x",
        "y",
        "size",
        "width",
        "height",
        "image"
      ],
      "additionalProperties": false
    },
    "CircleStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "circle"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/Amount"
        },
        "y": {
          "$ref": "#/$defs/Amount"
        },
        "size": {
          "type": "string",
          "enum": [
            "px",
            "fraction"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "kind",
        "name",
        "x",
        "y",
        "size",
        "width",
        "height",
        "color"
      ],
      "additionalProperties": false
    },
    "RectStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rect"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/Amount"
        },
        "y": {
          "$ref": "#/$defs/Amount"
        },
        "size": {
          "type": "string",
          "enum": [
            "px",
            "fraction"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "kind",
        "name",
        "x",
        "y",
        "size",
        "width",
        "height",
        "color"
      ],
      "additionalProperties": false
    },
    "CrossStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cross"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/Amount"
        },
        "y": {
          "$ref": "#/$defs/Amount"
        },
        "size": {
          "type": "string",
          "enum": [
            "px",
            "fraction"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "kind",
        "name",
        "x",
        "y",
        "size",
        "width",
        "height",
        "color"
      ],
      "additionalProperties": false
    },
    "TextStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/Amount"
        },
        "y": {
          "$ref": "#/$defs/Amount"
        },
        "size": {
          "type": "string",
          "enum": [
            "px",
            "fraction"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "x",
        "y",
        "size",
        "width",
        "height",
        "color",
        "text"
      ],
      "additionalProperties": false
    },
    "BackgroundStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "background"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "kind",
        "name",
        "color"
      ],
      "additionalProperties": false
    },
    "WavStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "wav"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sound": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^data:audio\\/"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "name",
        "sound",
        "duration"
      ],
      "additionalProperties": false
    },
    "TonesStimulus": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tones"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frequency": {
                "$ref": "#/$defs/Amount"
              },
              "duration": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "$ref": "#/$defs/ParamRef"
                  }
                ]
              }
            },
            "required": [
              "frequency",
              "duration"
            ],
            "additionalProperties": false
          }
        },
        "duration": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "tones",
        "duration"
      ],
      "additionalProperties": false
    }
  }
}
