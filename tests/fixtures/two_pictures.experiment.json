{
  "stages": [
    {
      "name": "discriminate",
      "machine": {
        "channels": {
          "inputs": [
            "lick_left",
            "lick_right",
            "screen_on"
          ],
          "outputs": [
            "reward"
          ]
        },
        "parameters": [
          {
            "name": "on_left",
            "type": "state",
            "default": "reward"
          },
          {
            "name": "on_right",
            "type": "state",
            "default": "error"
          },
          {
            "name": "reward_ms",
            "type": "time",
            "default": 50
          },
          {
            "name": "choice_ms",
            "type": "time",
            "default": 10000
          },
          {
            "name": "a_x",
            "type": "number",
            "default": 0.25
          },
          {
            "name": "b_x",
            "type": "number",
            "default": 0.75
          },
          {
            "name": "cue_hz",
            "type": "number",
            "default": 9500
          }
        ],
        "timers": [
          {
            "name": "choice_time",
            "time": {
              "param": "choice_ms"
            }
          },
          {
            "name": "reward_time",
            "time": {
              "param": "reward_ms"
            }
          },
          {
            "name": "error_time",
            "time": 2000
          }
        ],
        "counters": [],
        "start": "wait",
        "groups": [],
        "states": [
          {
            "name": "wait",
            "group": null,
            "onEntry": [
              {
                "show": "grey"
              },
              {
                "show": "fixation"
              },
              {
                "play": "cue"
              }
            ],
            "onExit": [],
            "transitions": [
              {
                "event": "cue.done",
                "target": "show",
                "actions": []
              }
            ]
          },
          {
            "name": "show",
            "group": null,
            "onEntry": [
              {
                "hide": "fixation"
              },
              {
                "show": "A"
              },
              {
                "show": "B"
              }
            ],
            "onExit": [],
            "transitions": [
              {
                "event": "screen_on.rise",
                "target": "choice",
                "actions": []
              }
            ]
          },
          {
            "name": "choice",
            "group": null,
            "onEntry": [
              {
                "start": "choice_time"
              }
            ],
            "onExit": [
              {
                "stop": "choice_time"
              }
            ],
            "transitions": [
              {
                "event": "lick_left.rise",
                "target": {
                  "param": "on_left"
                },
                "actions": []
              },
              {
                "event": "lick_right.rise",
                "target": {
                  "param": "on_right"
                },
                "actions": []
              },
              {
                "event": "choice_time.done",
                "target": "exit",
                "actions": []
              }
            ]
          },
          {
            "name": "reward",
            "group": null,
            "onEntry": [
              {
                "clear": true
              },
              {
                "high": "reward"
              },
              {
                "start": "reward_time"
              }
            ],
            "onExit": [
              {
                "low": "reward"
              }
            ],
            "transitions": [
              {
                "event": "reward_time.done",
                "target": "exit",
                "actions": []
              }
            ]
          },
          {
            "name": "error",
            "group": null,
            "onEntry": [
              {
                "clear": true
              },
              {
                "start": "error_time"
              }
            ],
            "onExit": [],
            "transitions": [
              {
                "event": "error_time.done",
                "target": "exit",
                "actions": []
              }
            ]
          }
        ],
        "layout": {
          "wait": {
            "x": 0,
            "y": 100
          },
          "show": {
            "x": 300,
            "y": 100
          },
          "choice": {
            "x": 600,
            "y": 100
          },
          "reward": {
            "x": 920,
            "y": -120
          },
          "error": {
            "x": 920,
            "y": 240
          }
        },
        "screen": {
          "width": 1080,
          "height": 1920
        },
        "stimuli": [
          {
            "kind": "background",
            "name": "grey",
            "color": "#404040"
          },
          {
            "kind": "cross",
            "name": "fixation",
            "x": 0.5,
            "y": 0.36,
            "size": "px",
            "width": 120,
            "height": 120,
            "color": "#ffffff"
          },
          {
            "kind": "image",
            "name": "A",
            "x": {
              "param": "a_x"
            },
            "y": 0.625,
            "size": "fraction",
            "width": 0.35,
            "height": 0.35,
            "image": "data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Cpolygon%20points%3D%2250%2C6%2096%2C92%204%2C92%22%20fill%3D%22%23f59e0b%22%2F%3E%3C%2Fsvg%3E"
          },
          {
            "kind": "image",
            "name": "B",
            "x": {
              "param": "b_x"
            },
            "y": 0.625,
            "size": "fraction",
            "width": 0.35,
            "height": 0.35,
            "image": "data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%2250%22%20r%3D%2244%22%20fill%3D%22%233b82f6%22%2F%3E%3C%2Fsvg%3E"
          },
          {
            "kind": "tones",
            "name": "cue",
            "tones": [
              {
                "frequency": {
                  "param": "cue_hz"
                },
                "duration": 100
              },
              {
                "frequency": 0,
                "duration": 100
              }
            ],
            "duration": 600
          }
        ]
      },
      "outcomes": {
        "reward": "correct",
        "error": "incorrect"
      }
    }
  ]
}
